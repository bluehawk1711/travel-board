# NestJS API base URL (see backend/.env.example for the API's required env vars).
# - iOS simulator / Android emulator / web: http://localhost:4000
# - Physical device: your machine's LAN IP, e.g. http://192.168.1.20:4000,
#   or the ngrok tunnel when the API runs behind one
EXPO_PUBLIC_API_URL=http://localhost:4000

# Google OAuth client IDs (for expo-auth-session)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id