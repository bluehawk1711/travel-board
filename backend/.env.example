# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Postgres (Neon)
DATABASE_URL=postgres://user:password@host/db

# Upstash Redis (REST-based, serverless)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Google Places API (server-side only — never exposed to clients)
GOOGLE_PLACES_API_KEY=your-key

# Auth (JWT)
JWT_SECRET=generate-a-long-random-string-32+chars
JWT_REFRESH_SECRET=another-long-random-string-32+chars

# Google OAuth (server-side only)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Web app origin used for OAuth redirects
FRONTEND_URL=http://localhost:3000

# ngrok tunnel (start-backend.ps1) — lets mobile dev builds reach this API.
# Get a token at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# When exposing via ngrok, add the tunnel URL to Google Cloud Console as an
# authorized redirect URI: https://your-domain.ngrok-free.dev/auth/google/callback
# and point GOOGLE_CALLBACK_URL at it.

# Image uploads (local disk for dev/MVP — swap for R2/S3 in production)
UPLOAD_DIR=./uploads

# Resend (email sending for password reset)
RESEND_API_KEY=re_your_api_key
MAIL_FROM=Travel Boards <noreply@travelboards.app>

# FCM push delivery (optional — without these, push is a logged no-op)
# Either a full service-account JSON (from Firebase console → Project settings):
FCM_SERVICE_ACCOUNT_JSON=
# …or the three fields individually:
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=