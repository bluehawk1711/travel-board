{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Explicit rootDir keeps the dist layout deterministic: inputs live under
    // src/ plus the root eslint.config.mts, so output is dist/src/main.js —
    // which is what `start:prod` (`node dist/src/main`) expects.
    "rootDir": "."
  },
  "exclude": ["node_modules", "test", "dist", "scripts", "**/*spec.ts"]
}
